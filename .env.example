# Copy to .env.local and fill in. Never commit .env.local.

# --- PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Sandbox PERSONAL account emails that receive operator payouts
# (developer.paypal.com > Testing Tools > Sandbox Accounts)
OPERATOR_A_EMAIL=
OPERATOR_B_EMAIL=

# Optional: Venmo sandbox payout test (US phone number, e.g. 4085551234)
VENMO_TEST_PHONE=

# --- Database (Supabase > Project Settings > Database > Connection string, "Transaction pooler" URI)
DATABASE_URL=

# --- Evidence storage (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI
# Anthropic API key (console.anthropic.com → API Keys)
AI_API_KEY=
AI_PLANNING_MODEL=claude-opus-5-5
AI_VISION_MODEL=claude-opus-5-5
AI_DAILY_CALL_LIMIT=200

# --- External agent (MCP) access
MCP_AGENT_API_KEY=

# --- App
APP_BASE_URL=http://localhost:3000
